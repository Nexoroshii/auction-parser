# =====================================================================
#  Локальный конфиг AuctionNotifier — переопределяет настройки внутри
#  JAR. Правьте ТОЛЬКО этот файл (пересборка не нужна). Он лежит рядом с
#  AuctionNotifier.bat в папке config\ и НЕ коммитится в git.
# =====================================================================
app:
  # US-прокси, чтобы работать без системного VPN. Только приложение ходит
  # через него; остальная система — напрямую.
  #   scheme: http   — работает для Copart И IAAI/Telegram (рекомендуется)
  #   scheme: socks5 — только Copart
  proxy:
    enabled: false          # ← поставьте true, когда впишете прокси
    scheme: http
    host: ""                # ← адрес прокси, напр. 12.34.56.78
    port: 0                 # ← порт, напр. 8080
    username: ""            # ← логин (если прокси без авторизации — оставьте пустым)
    password: ""            # ← пароль
  monitoring:
    # Горизонт поиска лотов: 1 = только сегодня, 2 = сегодня и завтра.
    # Это лишь стартовое значение — как только вы измените его через
    # Настройки в приложении, там сохранится своё значение и этот файл
    # больше не будет иметь эффекта (пока вы не удалите ключ из настроек).
    default-day-range: 2
